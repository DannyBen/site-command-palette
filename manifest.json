{
  "manifest_version": 3,
  "name": "Site Command Palette",
  "description": "A fast, contextual command palette for saving and recalling pages across the sites you use.",
  "version": "0.3.1",
  "icons": {
    "16": "support/icons/icon-16.png",
    "32": "support/icons/icon-32.png",
    "48": "support/icons/icon-48.png",
    "128": "support/icons/icon-128.png"
  },
  "key": "",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "optional_permissions": ["history"],
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["core.js", "storage.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "palette.css",
        "icons/edit.svg",
        "icons/delete.svg"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
